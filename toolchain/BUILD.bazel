load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load(":toolchain.bzl", "prometheus_toolchain", "current_prometheus_toolchain")

package(default_visibility = ["//visibility:public"])

exports_files(["toolchain.bzl"])

toolchain_type(name = "prometheus")

# The resolved prometheus + promtool for the target platform, usable as
# `data` (e.g. //tests:invalid_config_test).
current_prometheus_toolchain(name = "current")

# Per-platform toolchains. Each `prometheus_<ver>_<plat>` repo (created
# by the module extension) ships prometheus + promtool for one platform.

prometheus_toolchain(
    name           = "prometheus_linux_amd64_impl",
    version        = "3.15.1",
    prometheus_bin = "@prometheus_3_15_1_linux_amd64//:prometheus_bin",
    promtool_bin   = "@prometheus_3_15_1_linux_amd64//:promtool_bin",
)

toolchain(
    name                   = "prometheus_linux_amd64",
    toolchain_type         = ":prometheus",
    exec_compatible_with   = ["@platforms//os:linux", "@platforms//cpu:x86_64"],
    target_compatible_with = ["@platforms//os:linux", "@platforms//cpu:x86_64"],
    toolchain              = ":prometheus_linux_amd64_impl",
)

prometheus_toolchain(
    name           = "prometheus_linux_arm64_impl",
    version        = "3.15.1",
    prometheus_bin = "@prometheus_3_15_1_linux_arm64//:prometheus_bin",
    promtool_bin   = "@prometheus_3_15_1_linux_arm64//:promtool_bin",
)

toolchain(
    name                   = "prometheus_linux_arm64",
    toolchain_type         = ":prometheus",
    exec_compatible_with   = ["@platforms//os:linux", "@platforms//cpu:arm64"],
    target_compatible_with = ["@platforms//os:linux", "@platforms//cpu:arm64"],
    toolchain              = ":prometheus_linux_arm64_impl",
)

prometheus_toolchain(
    name           = "prometheus_darwin_amd64_impl",
    version        = "3.15.1",
    prometheus_bin = "@prometheus_3_15_1_darwin_amd64//:prometheus_bin",
    promtool_bin   = "@prometheus_3_15_1_darwin_amd64//:promtool_bin",
)

toolchain(
    name                   = "prometheus_darwin_amd64",
    toolchain_type         = ":prometheus",
    exec_compatible_with   = ["@platforms//os:osx", "@platforms//cpu:x86_64"],
    target_compatible_with = ["@platforms//os:osx", "@platforms//cpu:x86_64"],
    toolchain              = ":prometheus_darwin_amd64_impl",
)

prometheus_toolchain(
    name           = "prometheus_darwin_arm64_impl",
    version        = "3.15.1",
    prometheus_bin = "@prometheus_3_15_1_darwin_arm64//:prometheus_bin",
    promtool_bin   = "@prometheus_3_15_1_darwin_arm64//:promtool_bin",
)

toolchain(
    name                   = "prometheus_darwin_arm64",
    toolchain_type         = ":prometheus",
    exec_compatible_with   = ["@platforms//os:osx", "@platforms//cpu:arm64"],
    target_compatible_with = ["@platforms//os:osx", "@platforms//cpu:arm64"],
    toolchain              = ":prometheus_darwin_arm64_impl",
)

bzl_library(
    name = "toolchain",
    srcs = ["toolchain.bzl"],
    deps = ["//private:providers"],
)
