#!/usr/bin/env bash
# prometheus_server wrapper: resolves runfiles, execs the launcher.
# Substitution markers use __KEY__ syntax to avoid colliding with bash.
set -euo pipefail

if [[ -z "${RUNFILES_DIR:-}" ]]; then
  if [[ -n "${TEST_SRCDIR:-}" ]]; then RUNFILES_DIR="$TEST_SRCDIR"
  elif [[ -d "${0}.runfiles" ]]; then RUNFILES_DIR="${0}.runfiles"
  fi
  : "${RUNFILES_DIR:?prometheus_server: no runfiles found; run it with bazel run / bazel test}"
  export RUNFILES_DIR
fi

resolve() {
  local p="$1"
  for c in "${RUNFILES_DIR}/_main/${p}" "${RUNFILES_DIR}/${p}" "${RUNFILES_DIR}/${p#../}"; do
    [[ -e "$c" ]] && { printf '%s\n' "$c"; return; }
  done
  echo "prometheus_server: not in runfiles: ${p}" >&2
  exit 1
}

name='__NAME__'
tmp="${TEST_TMPDIR:-${TMPDIR:-/tmp}}"
# Resolve into variables first: a failing $(resolve) inside an argument
# list would not stop the script under `set -e`.
config="$(resolve '__CONFIG__')"
launcher="$(resolve '__LAUNCHER__')"
prometheus="$(resolve '__PROMETHEUS__')"
promtool="$(resolve '__PROMTOOL__')"

exec python3 "$launcher" \
  --prometheus "$prometheus" \
  --promtool "$promtool" \
  --config-dir "$(dirname "$config")" \
  --env-file "$tmp/$name.env" \
  --state-dir "$tmp/prometheus-$name" \
  --ready-timeout '__READY_TIMEOUT__' \
  -- __EXTRA_ARGS__ "$@"
