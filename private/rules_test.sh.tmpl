#!/usr/bin/env bash
# prometheus_rules_test — `promtool test rules` over the staged test files
# (rule files sit beside them by basename). JUnit XML goes to Bazel's
# XML_OUTPUT_FILE.
set -euo pipefail

root="${TEST_SRCDIR:-${RUNFILES_DIR:-$0.runfiles}}"
resolve() {
  local p="$1"
  for c in "$root/_main/$p" "$root/$p" "$root/${p#../}"; do
    [[ -e "$c" ]] && { printf '%s\n' "$c"; return; }
  done
  echo "prometheus_rules_test: not in runfiles: $p" >&2
  exit 1
}
PROMTOOL="$(resolve '__PROMTOOL__')"
dir="$(resolve '__DIR__')"

junit=()
[[ -n "${XML_OUTPUT_FILE:-}" ]] && junit=(--junit="$XML_OUTPUT_FILE")
cd "$dir"
# shellcheck disable=SC2086  # __RUN__ / __TESTS__ are space-separated lists
exec "$PROMTOOL" test rules "${junit[@]}" __RUN__ __TESTS__
